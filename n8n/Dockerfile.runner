FROM n8nio/runners:stable

USER root

# Install npm packages that can be used in Code nodes
# These must match NODE_FUNCTION_ALLOW_EXTERNAL in n8n-task-runners.json
# Note: n8nio/runners uses pnpm, not npm
# TODO(#111): drop the chmod once n8nio/runners ships pnpm with the execute bit
# (broken since 2026-09-02, pnpm 11.22.0: "/bin/sh: pnpm: Permission denied")
RUN chmod +x "$(readlink -f /usr/local/bin/pnpm)" && pnpm add cheerio axios moment lodash

# Copy task runner configuration
COPY n8n-task-runners.json /etc/n8n-task-runners.json

# --- fork: broker watchdog around the launcher (see FORK.md) ---
# Shadow the real launcher with a thin supervisor that exits the container when
# the task broker is permanently unreachable (worker restarted -> sidecar
# stranded in its dead network namespace), so `restart: unless-stopped` re-
# attaches the runner. The compose `entrypoint` (which calls task-runner-launcher)
# is intentionally NOT touched, so upstream can change it without conflict.
RUN mv /usr/local/bin/task-runner-launcher /usr/local/bin/task-runner-launcher.real
COPY runner-watchdog.sh /usr/local/bin/task-runner-launcher
RUN chmod +x /usr/local/bin/task-runner-launcher
# --- end fork ---

USER runner
